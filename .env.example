# Example environment configuration for RAG API
# Copy this file to .env and update with your actual values

# OpenAI Configuration (default provider)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider Configuration
# Options: openai, ollama, anthropic, cohere, azure
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=${OPENAI_API_KEY}
LLM_BASE_URL=
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# Embedding Provider Configuration
# Options: openai, cohere, huggingface, ollama, azure
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_API_KEY=${OPENAI_API_KEY}
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536

# Vector Database Configuration
QDRANT_URL=http://localhost:6333

# Processing Configuration
CHUNK_SIZE=2000
TOP_K=5

# Alternative Provider Examples:

# Ollama Local Models (privacy-focused)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama2
# LLM_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text

# Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-sonnet-20240229
# LLM_API_KEY=your_anthropic_api_key

# Cohere
# LLM_PROVIDER=cohere
# LLM_MODEL=command
# LLM_API_KEY=your_cohere_api_key
# EMBEDDING_PROVIDER=cohere
# EMBEDDING_MODEL=embed-english-v3.0

# Azure OpenAI
# LLM_PROVIDER=azure
# LLM_MODEL=gpt-35-turbo
# LLM_BASE_URL=https://your-resource.openai.azure.com
# LLM_API_KEY=your_azure_api_key
